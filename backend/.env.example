# Porta do servidor
PORT=4000

# Postgres — em produção, connection string do Supabase com pooler (modo
# "Transaction"). Em desenvolvimento local, pode apontar pro Postgres do
# docker-compose.yml da raiz do repo (`docker compose up -d`):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stakeholder_virtual"
# Em produção, troque pela do Supabase, algo como:
# DATABASE_URL="postgresql://postgres:SENHA@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"

# JWT
JWT_ACCESS_SECRET="hgUIGFuyitfdTUguitGygOUYIGyuihgYHGByhu"
JWT_REFRESH_SECRET="JGupOIJKMu90t679vhBY80Gy78g907bYUHBy78h"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Storage dos PDFs: "local" salva em backend/uploads/reports (bom pra
# desenvolvimento, sem precisar de conta no Supabase). Em produção, troque
# para "supabase" e preencha as 3 variáveis abaixo.
STORAGE_DRIVER=local

# Supabase Storage (bucket privado "reports") - só é obrigatório quando
# STORAGE_DRIVER=supabase
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_KEY="service_role_key_aqui"
SUPABASE_STORAGE_BUCKET="reports"

# Microserviço Python (ADK)
ADK_SERVICE_URL="http://localhost:8000"

# CORS - domínio do frontend (Vercel)
CORS_ORIGIN="http://localhost:5173"

# "true" em produção (necessário para cookies SameSite=None; Secure)
COOKIE_SECURE=false

# Endereço do site (usado no link do e-mail de redefinição de senha).
# Em produção: FRONTEND_URL="https://stackholdervirtual.online". Vazio = usa CORS_ORIGIN.
FRONTEND_URL="http://localhost:5173"
# Validade do link de redefinição de senha, em minutos
PASSWORD_RESET_TTL_MIN=30

# E-mail que envia a redefinição de senha — ALTERE para a conta que você criar.
# Sem MAIL_HOST, em desenvolvimento o link só aparece no console do backend.
# Hostinger: smtp.hostinger.com, porta 465, MAIL_SECURE=true.
# Gmail: smtp.gmail.com, porta 465, e uma "senha de app" em MAIL_PASSWORD.
MAIL_HOST=""
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER="seu-email@seudominio.com"
MAIL_PASSWORD="ALTERE_a_senha_do_email"
MAIL_FROM="Stakeholder Virtual <seu-email@seudominio.com>"

# Conta de superadmin (modo desenvolvedor) criada pelo `npm run seed` — ALTERE.
# Em produção o seed se recusa a rodar com a senha padrão.
SEED_SUPERADMIN_EMAIL="superadmin@gmail.com"
SEED_SUPERADMIN_PASSWORD="ALTERE_esta_senha"



