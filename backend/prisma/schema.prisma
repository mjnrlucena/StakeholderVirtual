generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ALUNO: uso convencional. PROFESSOR: hub completo (menos promover outros
// professores). GESTOR: hub só para responder/descartar perguntas não
// respondidas. SUPERADMIN: tudo, inclusive promover e gerenciar turmas.
enum Role {
  ALUNO
  PROFESSOR
  GESTOR
  SUPERADMIN
}

enum LogKind {
  PERGUNTA
  FEEDBACK
}

enum MessageRole {
  USER
  STAKEHOLDER
  FEEDBACK
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Opcional só por causa das contas criadas antes de o cadastro pedir o nome.
  nome         String?
  passwordHash String
  role         Role     @default(ALUNO)
  turmaId      String?
  // Turma e equipe ativas: as escolhidas no login (quem tem mais de uma
  // matrícula), usadas nos logs e na lista de projetos.
  turma        Turma?   @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  equipeId     String?
  equipe       Equipe?  @relation(fields: [equipeId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  refreshTokens       RefreshToken[]
  chats               Chat[]
  unansweredQuestions UnansweredQuestion[]
  matriculas          Matricula[]
}

// Turmas (e a equipe em cada uma) de quem estuda em mais de uma turma; só
// professor/superadmin cadastram. Contas antigas têm só User.turmaId/equipeId,
// então leia sempre a união dos dois (vinculosDoUsuario).
model Matricula {
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  turmaId  String
  turma    Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  equipeId String?
  equipe   Equipe? @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  @@id([userId, turmaId])
}

model Turma {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())

  users      User[]
  matriculas Matricula[]
  equipes    Equipe[]
  // Turmas que podem ver o projeto (professor/superadmin veem todos).
  projects Project[]
}

model Equipe {
  id        String   @id @default(uuid())
  nome      String
  turmaId   String
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  users      User[]
  matriculas Matricula[]

  @@unique([turmaId, nome])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  pdfPath     String // chave do arquivo dentro do bucket do Supabase Storage
  reportText  String // texto extraído do PDF, cacheado para não reprocessar a cada pergunta
  createdAt   DateTime @default(now())

  chats               Chat[]
  unansweredQuestions UnansweredQuestion[]
  turmas              Turma[]
}

// Cada Chat é uma sessão de conversa do usuário com o projeto; ele pode ter
// várias. Sem nome, a sessão aparece como "Sessão {number}".
model Chat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int      @default(1)
  name      String?
  createdAt DateTime @default(now())

  // Agrupa os logs da sessão; os logs sobrevivem mesmo se ela for apagada.
  sessionId String   @default(uuid())

  messages Message[]

  @@index([userId, projectId])
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  grounded  Boolean? // null para mensagens do usuário; true/false para respostas do stakeholder
  createdAt DateTime    @default(now())

  @@index([chatId])
}

// Perguntas em que o relatório não tinha informação suficiente (mesmo
// quando o stakeholder respondeu "não sei" de forma honesta, sem inventar).
model UnansweredQuestion {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  question  String
  // Sessão do chat (Chat.sessionId) para mostrar o contexto no hub; null nas antigas.
  sessionId String?
  createdAt DateTime @default(now())

  // Preenchidos quando o admin responde: a resposta é anexada ao
  // reportText do projeto, virando contexto para perguntas futuras.
  answer     String?
  reviewed   Boolean  @default(false)
  answeredAt DateTime?

  @@index([projectId])
}

// Log imutável de cada interação (pergunta + resposta). Fica separado de
// Message porque "Nova conversa" apaga as mensagens, mas o log precisa
// sobreviver. Sem foreign keys de propósito: turma e projeto são
// snapshots, então o histórico continua correto mesmo que o aluno mude
// de turma ou que algo seja removido. Não guarda e-mail.
//
// A busca textual usa índices GIN (pg_trgm + unaccent) criados na migration
// sobre immutable_unaccent(lower(prompt|response)) — o Prisma não os
// representa, por isso eles só existem no SQL da migration.
model InteractionLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  kind            LogKind  @default(PERGUNTA)
  sessionId       String
  userId          String?
  userRole        Role
  turmaId         String?
  turmaNome       String
  projectId       String
  projectTitle    String
  prompt          String
  response        String
  grounded        Boolean?
  coveredByReport Boolean?
  latencyMs       Int
  error           String?

  @@index([createdAt])
  @@index([turmaId])
  @@index([projectId])
  @@index([sessionId])
}
