generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ALUNO: uso convencional. PROFESSOR: hub completo (menos promover outros
// professores). GESTOR: hub só para responder/descartar perguntas não
// respondidas. SUPERADMIN: tudo, inclusive promover e gerenciar turmas.
enum Role {
  ALUNO
  PROFESSOR
  GESTOR
  SUPERADMIN
}

enum LogKind {
  PERGUNTA
  FEEDBACK
}

enum MessageRole {
  USER
  STAKEHOLDER
  FEEDBACK
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ALUNO)
  turmaId      String?
  turma        Turma?   @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  refreshTokens       RefreshToken[]
  chats               Chat[]
  unansweredQuestions UnansweredQuestion[]
}

model Turma {
  id        String   @id @default(uuid())
  nome      String   @unique
  createdAt DateTime @default(now())

  users User[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  pdfPath     String // chave do arquivo dentro do bucket do Supabase Storage
  reportText  String // texto extraído do PDF, cacheado para não reprocessar a cada pergunta
  createdAt   DateTime @default(now())

  chats               Chat[]
  unansweredQuestions UnansweredQuestion[]
}

// Um único chat "ativo" por usuário + projeto. "Reiniciar" apaga as
// mensagens deste chat em vez de criar um novo registro.
model Chat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Muda a cada "Nova conversa": agrupa os logs de uma mesma conversa,
  // mesmo depois de as mensagens do chat terem sido apagadas.
  sessionId String   @default(uuid())

  messages Message[]

  @@unique([userId, projectId])
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  chat      Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  grounded  Boolean? // null para mensagens do usuário; true/false para respostas do stakeholder
  createdAt DateTime    @default(now())

  @@index([chatId])
}

// Perguntas em que o relatório não tinha informação suficiente (mesmo
// quando o stakeholder respondeu "não sei" de forma honesta, sem inventar).
model UnansweredQuestion {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  question  String
  createdAt DateTime @default(now())

  // Preenchidos quando o admin responde: a resposta é anexada ao
  // reportText do projeto, virando contexto para perguntas futuras.
  answer     String?
  reviewed   Boolean  @default(false)
  answeredAt DateTime?

  @@index([projectId])
}

// Log imutável de cada interação (pergunta + resposta). Fica separado de
// Message porque "Nova conversa" apaga as mensagens, mas o log precisa
// sobreviver. Sem foreign keys de propósito: turma e projeto são
// snapshots, então o histórico continua correto mesmo que o aluno mude
// de turma ou que algo seja removido. Não guarda e-mail.
//
// A busca textual usa índices GIN (pg_trgm + unaccent) criados na migration
// sobre immutable_unaccent(lower(prompt|response)) — o Prisma não os
// representa, por isso eles só existem no SQL da migration.
model InteractionLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  kind            LogKind  @default(PERGUNTA)
  sessionId       String
  userId          String?
  userRole        Role
  turmaId         String?
  turmaNome       String
  projectId       String
  projectTitle    String
  prompt          String
  response        String
  grounded        Boolean?
  coveredByReport Boolean?
  latencyMs       Int
  error           String?

  @@index([createdAt])
  @@index([turmaId])
  @@index([projectId])
  @@index([sessionId])
}
