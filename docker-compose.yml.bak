services:
  postgres:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  adk-service:
    build: ./adk-service
    restart: unless-stopped
    env_file: adk.env
    expose:
      - "8000"

  backend:
    build: ./backend
    restart: unless-stopped
    env_file: backend.env
    volumes:
      - uploads:/app/uploads
    depends_on:
      postgres:
        condition: service_healthy
      adk-service:
        condition: service_started
    expose:
      - "3000"

    frontend:
    build:
      context: ./frontend
      args:
        VITE_API_URL: https://api.stackholdervirtual.online
    restart: unless-stopped
    expose:
      - "80"

  caddy:
    image: caddy:2
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - backend
      - frontend
volumes:
  pgdata:
  uploads:
  caddy_data:
  caddy_config:
