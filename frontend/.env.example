# Porta do servidor de desenvolvimento do Vite (npm run dev)
PORT=5173

# URL do Flask local, usada em desenvolvimento pelo proxy do Vite (/pergunta).
# Em produção não é necessária: o próprio backend serve o build do front
# e responde na mesma origem (sem CORS).
VITE_API_URL=http://localhost:5000


# NÃO coloque OPENAI_API_KEY aqui. Qualquer variável do frontend (Vite)
# vai parar no bundle JS entregue ao navegador. A chave da OpenAI deve
# ficar só no .env da raiz ou nas Environment Variables do
# projeto (Vercel) — nunca em código.
